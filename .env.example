# =========================================================
# Reverie environment
# =========================================================
# Copy this file to .env and fill in the values. The .env
# file itself is never committed.
#
#   cp .env.example .env
# =========================================================

# Database
PG_DB=reverie_db
PG_USER=reverie_user
PG_PASSWORD=change-me

# Signing key for the access tokens. Must be at least 32
# characters; anything shorter is rejected on startup.
# Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# How long an access token stays valid, in milliseconds.
# One hour by default.
JWT_EXPIRATION_MS=3600000