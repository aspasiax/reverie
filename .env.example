# =========================================================
# Reverie environment
# =========================================================
# Copy this file to .env and fill in the values. The .env
# file itself is never committed.
#
#   cp .env.example .env
# =========================================================

# Database
PG_DB=reverie_db
PG_USER=reverie_user
PG_PASSWORD=change-me

# Signing key for the access tokens. Read as Base64 and must
# decode to at least 32 bytes; anything shorter is refused on
# startup. Leave this empty and paste in the output of:
#
#   openssl rand -base64 48
#
JWT_SECRET=

# How long an access token stays valid, in milliseconds.
# One hour by default.
JWT_EXPIRATION_MS=3600000